# Application Environment (development, production, testing)
APP_ENV=development

# Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///./affiliate.db

# TikTok Collector Settings
TIKTOK_REGION=VN
HEADLESS=true
MAX_CONCURRENCY=2
MAX_RETRIES=3
REQUEST_TIMEOUT=30
REQUEST_DELAY_MIN=1
REQUEST_DELAY_MAX=3

# Scheduler Settings (HH:MM list format)
CRAWL_SCHEDULE=08:00,12:00,16:00,20:00,00:00
TRACKED_PRODUCTS_PER_RUN=100
